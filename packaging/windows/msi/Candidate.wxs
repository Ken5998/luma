<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package Name="Luma MSI Candidate" Manufacturer="Kenan Kasumović" Version="$(var.Version)"
           UpgradeCode="42DE6B9C-4A80-4BA8-9886-8D8F9B7F24AD" Scope="perUser" Language="1033" Codepage="65001">
    <SummaryInformation Codepage="1250" />
    <MajorUpgrade DowngradeErrorMessage="A newer Luma MSI candidate is already installed." Schedule="afterInstallExecute" />
    <MediaTemplate EmbedCab="yes" />
    <Launch Condition="Installed OR NOT RollbackDisabled" Message="Enable Windows Installer rollback before installing Luma." />
    <Property Id="ARPURLINFOABOUT" Value="https://luma.ksmvc.ch" />
    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="LumaFolder" Name="Luma">
        <Component Id="ParentFolderCleanup" Guid="8C41CB66-D40C-4F79-BEA5-B177C20BA60B">
          <RegistryValue Root="HKCU" Key="Software\Luma\WindowsInstaller" Name="ParentFolder" Value="1" Type="integer" KeyPath="yes" />
          <RemoveFolder Id="RemoveEmptyParent" On="uninstall" />
        </Component>
        <Directory Id="INSTALLFOLDER" Name="WindowsInstaller">
          <Component Id="Payload" Guid="5CB00FCB-2CC7-4D44-A2D4-1E271D192118">
            <File Id="ScreenSaver" Source="$(var.Payload)/Luma.scr" />
            <File Source="$(var.Payload)/LICENSE" />
            <RegistryValue Root="HKCU" Key="Software\Luma\WindowsInstaller" Name="InstallDirectory" Value="[INSTALLFOLDER]" Type="string" KeyPath="yes" />
            <RemoveFolder Id="RemoveInstallFolder" On="uninstall" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>
    <Feature Id="Main" Title="Luma" Level="1"><ComponentRef Id="Payload" /><ComponentRef Id="ParentFolderCleanup" /></Feature>
    <ui:WixUI Id="WixUI_Minimal" />
    <WixVariable Id="WixUILicenseRtf" Value="$(var.LicenseRtf)" />
    <Property Id="LEGACYFOLDER" Secure="yes" />
    <SetProperty Id="LEGACYFOLDER" Value="[LocalAppDataFolder]Luma\Screensaver" After="CostFinalize" Sequence="execute" Condition="NOT LEGACYFOLDER" />
    <Binary Id="NativeActions" SourceFile="$(var.Actions)" />
    <CustomAction Id="PrepareSelection" BinaryRef="NativeActions" DllEntry="Prepare" Execute="immediate" Return="check" />
    <CustomAction Id="RollbackSelection" BinaryRef="NativeActions" DllEntry="Rollback" Execute="rollback" Impersonate="yes" Return="check" />
    <CustomAction Id="ChangeSelection" BinaryRef="NativeActions" DllEntry="Change" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="ChangeRemoval" BinaryRef="NativeActions" DllEntry="Change" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="RemoveLegacyInno" Property="LEGACYUNINSTALLER" ExeCommand="/VERYSILENT /SUPPRESSMSGBOXES /NORESTART" Execute="commit" Impersonate="yes" Return="ignore" />
    <CustomAction Id="CommitLegacy" BinaryRef="NativeActions" DllEntry="CommitLegacy" Execute="commit" Impersonate="yes" Return="ignore" />
    <?if $(var.TestHooks) = 1 ?>
    <Property Id="LUMA_TEST_FAIL" Secure="yes" />
    <Property Id="LUMA_REPORT" Secure="yes" />
    <Property Id="LUMA_TEST_SELECTION" Secure="yes" />
    <Property Id="LUMA_TEST_RESTORE" Secure="yes" />
    <CustomAction Id="TestSeed" BinaryRef="NativeActions" DllEntry="TestSeed" Execute="immediate" Return="check" />
    <CustomAction Id="TestVerify" BinaryRef="NativeActions" DllEntry="TestVerify" Execute="immediate" Return="check" />
    <CustomAction Id="FailForTest" BinaryRef="NativeActions" DllEntry="FailForTest" Execute="deferred" Impersonate="yes" Return="check" />
    <CustomAction Id="FailRemovalForTest" BinaryRef="NativeActions" DllEntry="FailForTest" Execute="deferred" Impersonate="yes" Return="check" />
    <?endif?>
    <InstallExecuteSequence>
      <Custom Action="PrepareSelection" After="InstallInitialize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="RollbackSelection" After="PrepareSelection" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="ChangeRemoval" After="RollbackSelection" Condition="NOT UPGRADINGPRODUCTCODE AND REMOVE = &quot;ALL&quot;" />
      <Custom Action="ChangeSelection" After="InstallFiles" Condition="NOT UPGRADINGPRODUCTCODE AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="RemoveLegacyInno" After="ChangeSelection" Condition="NOT UPGRADINGPRODUCTCODE AND NOT (REMOVE = &quot;ALL&quot;) AND LEGACYUNINSTALLER" />
      <Custom Action="CommitLegacy" After="RemoveLegacyInno" Condition="NOT UPGRADINGPRODUCTCODE AND NOT (REMOVE = &quot;ALL&quot;)" />
      <?if $(var.TestHooks) = 1 ?>
      <Custom Action="TestSeed" Before="PrepareSelection" Condition="NOT UPGRADINGPRODUCTCODE" />
      <Custom Action="FailRemovalForTest" After="ChangeRemoval" Condition="LUMA_TEST_FAIL = 1 AND REMOVE = &quot;ALL&quot;" />
      <Custom Action="FailForTest" After="ChangeSelection" Condition="LUMA_TEST_FAIL = 1 AND NOT (REMOVE = &quot;ALL&quot;)" />
      <Custom Action="TestVerify" After="InstallFinalize" Condition="NOT UPGRADINGPRODUCTCODE" />
      <?endif?>
    </InstallExecuteSequence>
  </Package>
</Wix>
